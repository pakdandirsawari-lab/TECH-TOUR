# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Sheets Central Database (Apps Script Web App Backend)
# Paste your deployed Google Apps Script Web App /exec URL here so all users share the same cloud sheet automatically.
APPS_SCRIPT_WEB_APP_URL=""

# Optional shared API secret configured in Google Apps Script Script Properties (API_SECRET)
APPS_SCRIPT_API_SECRET=""

# Target Google Spreadsheet ID
GOOGLE_SPREADSHEET_ID="1BtuAFZPHsQPiXBijVVQTFWu4Dn2EsajLaSYaRtJHkcM"

# Server session signing secret (set a strong random string in production)
SESSION_SECRET=""

# Initial bootstrap Admin account before Users sheet is connected/customized
ADMIN_BOOTSTRAP_EMAIL="admin@himalayanhorizons.in"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMe123!"
